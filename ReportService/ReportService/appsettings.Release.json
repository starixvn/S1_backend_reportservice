{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System": "Error",
      "Microsoft": "Error"
    }
  },
  "Serilog": {
    "Name": "ServiceFile",
    "MinimumLevel": {
      "Default": "Information",
      "Overwrite": {
        "Name": "Microsoft",
        "Level": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/report/report-.log",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      },
      {
        "Name": "Console"
      }
    ]
  },
  "ElasticApm": {
    "ServiceName": "ReportService",
    "ServiceVersion": "v1.0",
    "Environment": "Release",
    "LogLevel": "Info",
    "ServerUrl": "http://54.151.226.243:8200",
    "TransactionIgnoreUrls": "/health",
    "TransactionSampleRate": 1.0,
    "MaxBatchEventCount": 10
  },
  "ConfigService": [ "http://10.4.194.29:7242/", "http://10.4.194.27:7242/" ]
}